# Database. SQLite for local dev; PostgreSQL (e.g. Supabase) in production.
# DATABASE_URL=sqlite+aiosqlite:///./helios.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/helios

# Auth
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080

# LLM — supply your own keys. Provider-agnostic via OpenAI-compatible API.
# USER_LLM_* is the fallback for every task when task-specific keys are empty.
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini
USER_LLM_EMBEDDING_MODEL=text-embedding-3-small

# Optional per-task routes. Separate keys isolate quotas/rate limits.
# Leave empty to fall back to USER_LLM_*.
# GENERAL_LLM_PROVIDER=
# GENERAL_LLM_API_KEY=your-api-key-here
# GENERAL_LLM_BASE_URL=
# GENERAL_LLM_MODEL=
# GENERAL_LLM_FALLBACK_MODEL=

# AUTOMATION_LLM_PROVIDER=
# AUTOMATION_LLM_API_KEY=your-api-key-here
# AUTOMATION_LLM_BASE_URL=
# AUTOMATION_LLM_MODEL=
# AUTOMATION_LLM_FALLBACK_MODEL=

# CODE_LLM_PROVIDER=
# CODE_LLM_API_KEY=your-api-key-here
# CODE_LLM_BASE_URL=
# CODE_LLM_MODEL=
# CODE_LLM_FALLBACK_MODEL=

# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=your-api-key-here
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=

# STT_PROVIDER=
# STT_API_KEY=your-api-key-here
# STT_BASE_URL=
# STT_MODEL=

# TTS_PROVIDER=
# TTS_API_KEY=your-api-key-here
# TTS_BASE_URL=
# TTS_MODEL=

# Reliability — retry transient provider errors (429/5xx/empty body) and, on a
# free-tier plan, keep auto model routing on :free models only so a paid route
# never fails mid-conversation with an out-of-credits error.
# LLM_MAX_ATTEMPTS=3
# LLM_RETRY_BACKOFF_SECONDS=0.6
# LLM_AUTO_ROUTE_FREE_ONLY=true

# Conversation style — professional, clear tone that mirrors the user's
# language (professional Hinglish when they write Hinglish). Presets:
# professional (default) | modern_hinglish | neutral.
# Set CHAT_STYLE_ENABLED=false for the bare factual assistant.
# CHAT_STYLE=professional
# CHAT_STYLE_ENABLED=true

# Default timezone for the real-time clock in the system prompt and the
# current_datetime tool (so date/time answers match the user's local day).
# Also used for daily automation schedules.
# DEFAULT_TIMEZONE=Asia/Kolkata

# Background workers poll intervals (seconds).
# REMINDER_POLL_SECONDS=30
# AUTOMATION_POLL_SECONDS=60

# Web search — provider is swappable via SEARCH_PROVIDER.
# SEARCH_PROVIDER=duckduckgo
# SEARCH_API_KEY=            # required only for key-based providers
# WEB_SEARCH_MAX_RESULTS=8
# WEB_SEARCH_TIMEOUT_SECONDS=20
# WEB_FETCH_MAX_CHARS=8000
# WEB_SEARCH_MAX_QUERIES=3
# WEB_SEARCH_RESULTS_PER_QUERY=5
# WEB_FETCH_MAX_PAGES=2
# WEB_SEARCH_CACHE_TTL_SECONDS=300
